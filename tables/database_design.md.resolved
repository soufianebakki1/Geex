        float surface_max
        enum mode_financement
        string delai_achat
        string motivation
        datetime date_affectation
        datetime derniere_activite
        string motif_annulation
        datetime created_at
    }

    ACTIVITES {
        int id PK
        int lead_id FK
        int user_id FK
        enum canal
        datetime date_heure
        int duree_minutes
        enum resultat
        string notes
        datetime created_at
    }

    PRERESERVATIONS {
        int id PK
        int lead_id FK
        int lot_id FK
        int commercial_id FK
        string numero_unique
        datetime date_creation
        datetime date_expiration
        string motif
        string commentaires
        enum statut
        datetime date_prolongation
        string motif_annulation
        datetime created_at
    }

    DOSSIERS {
        int id PK
        int prereservation_id FK
        int lead_id FK
        int commercial_id FK
        enum type_client
        enum statut
        datetime date_ouverture
        datetime date_validation
        datetime created_at
    }

    DOCUMENTS {
        int id PK
        int dossier_id FK
        string nom
        string categorie
        string chemin_fichier
        enum statut
        int valide_par FK
        datetime date_upload
